{
  "name": "@alife/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint",
    "test": "node --test --test-concurrency=4 \"test/unit/**/*.test.ts\"",
    "alife": "node dist/cli.js",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "measure:packing": "node scripts/measure-packing.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
